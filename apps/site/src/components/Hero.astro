---
import { links, proofChips } from "../content/site";
import ScreenshotFrame from "./ScreenshotFrame.astro";
---

<section class="hero-rebuild">
  <div class="container hero-inner">
    <h1>Own your AI context. Validate it <span>locally</span>. Export it anywhere.</h1>
    <p class="hero-subtitle">
      Build validated Context Packs from local files, notes, sources, and rules, then reuse them across the AI tools you
      already use.
    </p>
    <p class="hero-targets">
      Use Context Packs through human-readable HTML, exports, CLI, API, Docker, and read-only MCP.
    </p>
    <p class="hero-targets">
      Current profiles include ChatGPT, Claude, Codex, generic Markdown, JSON, AGENTS.md, CLAUDE.md, and llms.txt;
      generated Markdown briefs can be used with other AI tools.
    </p>

    <div class="hero-actions">
      <a class="button button-primary" href={links.github}>View the repo</a>
      <a class="button button-secondary" href="/run-locally">Run locally</a>
      <a class="button button-quiet" href={links.demoPacks}>View demo packs</a>
    </div>

    <ul class="proof-chips" aria-label="Product proof points">
      {proofChips.map((chip) => <li>{chip}</li>)}
    </ul>
  </div>

  <div class="container hero-preview">
    <ScreenshotFrame
      imageSrc="/screenshots/contextarr-dashboard.png"
      alt="Contextarr Pack Library dashboard showing local packs, health, review, exports, and source-backed context"
    />
  </div>
</section>
