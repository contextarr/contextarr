---
import { links, proofChips } from "../content/site";
import ScreenshotFrame from "./ScreenshotFrame.astro";
---

<section class="hero-rebuild">
  <div class="container hero-inner">
    <p class="status-badge">Context Packs / source-backed / export-ready</p>
    <h1>Trusted AI context. Locally prepared.</h1>
    <p class="hero-subtitle">
      Contextarr is a local-first Context Pack system that turns local files, records, sources, and rules into
      validated exports and read-only MCP context for AI tools. It is not an agent runner.
    </p>

    <div class="hero-actions">
      <a class="button button-primary" href={links.github}>View the repo</a>
      <a class="button button-secondary" href={links.verification}>Run locally</a>
    </div>

    <ul class="proof-chips" aria-label="Product proof points">
      {proofChips.map((chip) => <li>{chip}</li>)}
    </ul>
  </div>

  <div class="container hero-preview">
    <ScreenshotFrame
      imageSrc="/screenshots/contextarr-dashboard.png"
      alt="Contextarr Pack Library dashboard showing local packs, health, review, exports, and source-backed context"
      caption="Captured from the running local dashboard. No generated product screenshots."
    />
  </div>
</section>
