---
import BaseLayout from "../layouts/BaseLayout.astro";
import { advancedPreview, coreWorkingNow, explicitNonGoals, notIncludedYet } from "../content/status";

const nearTerm = [
  "repair stale release gates for the committed starter-pack set",
  "finish v0.1.0-alpha.1 release docs and known limitations",
  "keep reviewed screenshots current",
  "tighten the demo around validate, dashboard, health, export, MCP, and rebuild",
  "keep public feedback focused on Context Packs before adding more product surface"
];

const laterDirection = [
  "private team registry, only after the trust model matures",
  "signed artifacts, only after local validation and quarantine workflows are proven",
  "paid local desktop app, only after open-source pull exists"
];
---

<BaseLayout title="Roadmap | Contextarr" currentPath="/roadmap">
  <section class="page-hero">
    <div class="container narrow">
      <p class="eyebrow">Roadmap</p>
      <h1>Roadmap</h1>
      <p>
        Current status: developer preview. Core Context Pack workflows are being stabilized. Skills and Agent Kits
        are advanced-preview data objects and do not execute.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container status-grid">
      <article class="status-card">
        <h2>Core working now</h2>
        <ul class="check-list">
          {coreWorkingNow.map((item) => <li>{item}</li>)}
        </ul>
      </article>
      <article class="status-card">
        <h2>Advanced preview</h2>
        <ul class="check-list">
          {advancedPreview.map((item) => <li>{item}</li>)}
        </ul>
      </article>
      <article class="status-card status-card-muted">
        <h2>Not included</h2>
        <ul class="dash-list">
          {notIncludedYet.map((item) => <li>{item}</li>)}
        </ul>
      </article>
    </div>
  </section>

  <section class="section section-tight">
    <div class="container roadmap-columns">
      <article>
        <p class="eyebrow">Near-term</p>
        <h2>Prove the Context Pack loop.</h2>
        <ul class="dash-list">
          {nearTerm.map((item) => <li>{item}</li>)}
        </ul>
      </article>
      <article>
        <p class="eyebrow">Later direction</p>
        <h2>Only after the trust model matures.</h2>
        <ul class="dash-list">
          {laterDirection.map((item) => <li>{item}</li>)}
        </ul>
      </article>
    </div>
  </section>

  <section class="section security-band">
    <div class="container split-layout">
      <div>
        <p class="eyebrow">Explicit non-goals</p>
        <h2>Contextarr stays narrow on purpose.</h2>
      </div>
      <ul class="boundary-list">
        {explicitNonGoals.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </section>
</BaseLayout>
