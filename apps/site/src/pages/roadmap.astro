---
import BaseLayout from "../layouts/BaseLayout.astro";
import { advancedPreview, coreWorkingNow } from "../content/status";

const nearTerm = [
  "repair stale release gates for the committed starter-pack set",
  "finish v0.1.0-alpha.1 release docs and known limitations",
  "keep reviewed screenshots current",
  "tighten the demo around validate, dashboard, health, export, MCP, and rebuild",
  "keep public feedback focused on Context Packs before adding more product surface"
];

const laterDirection = [
  "keep Skills and Agent Kits as non-executing advanced-preview surfaces until Context Pack core is accepted",
  "keep registry, marketplace, signing, and distribution ideas out of the Wave 1 public product surface",
  "keep hosted vaults, telemetry, package publishing, and remote install behavior out of scope",
  "preserve imported external Skill artifacts without mutation or execution"
];
---

<BaseLayout title="Roadmap | Contextarr" currentPath="/roadmap">
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Roadmap</p>
      <h1>Roadmap</h1>
      <p>
        Current status: Context Pack Core developer preview. Core Context Pack workflows are the adoption target.
        Skills and Agent Kits are advanced-preview, non-executing surfaces. Native Skills stay data-only; imported
        external Skill artifacts may later be preserved as untrusted files.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container status-grid">
      <article class="status-card roadmap-page-card">
        <h2>Core working now</h2>
        <ul class="check-list">
          {coreWorkingNow.map((item) => <li>{item}</li>)}
        </ul>
      </article>
      <article class="status-card roadmap-page-card">
        <h2>Advanced preview</h2>
        <ul class="check-list">
          {advancedPreview.map((item) => <li>{item}</li>)}
        </ul>
      </article>
    </div>
  </section>

  <section class="section section-tight">
    <div class="container roadmap-columns">
      <article class="roadmap-page-card">
        <p class="eyebrow">Near-term</p>
        <h2>Prove the Context Pack loop.</h2>
        <ul class="dash-list">
          {nearTerm.map((item) => <li>{item}</li>)}
        </ul>
      </article>
      <article class="roadmap-page-card">
        <p class="eyebrow">Guardrails</p>
        <h2>Keep Wave 1 focused.</h2>
        <ul class="dash-list">
          {laterDirection.map((item) => <li>{item}</li>)}
        </ul>
      </article>
    </div>
  </section>
</BaseLayout>
