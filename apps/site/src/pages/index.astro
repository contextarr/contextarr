---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import PackAnatomy from "../components/PackAnatomy.astro";
import Pipeline from "../components/Pipeline.astro";
import LocalInstall from "../components/LocalInstall.astro";
import AudiencePositioning from "../components/AudiencePositioning.astro";
import ProofComparison from "../components/ProofComparison.astro";
import { contextFitRows, links } from "../content/site";
---

<BaseLayout currentPath="/">
  <Hero />
  <Pipeline />
  <PackAnatomy />
  <LocalInstall />
  <section class="section proof-cta-section">
    <div class="container route-split">
      <div>
        <p class="eyebrow">Launch proof</p>
        <h2>See the proof before you trust the pitch.</h2>
      </div>
      <div class="route-copy">
        <p>
          The proof route shows the 5-minute demo, all 15 demo evals, trust receipts, and the No context / Raw notes /
          Contextarr export comparison.
        </p>
        <div class="page-hero-actions">
          <a class="button button-primary" href="/proof">See the proof</a>
          <a class="button button-secondary" href="/run-locally#seven-minute-path">Try Contextarr in 7 minutes</a>
        </div>
      </div>
    </div>
  </section>
  <section class="section section-tight fit-section">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">Where Contextarr fits</p>
        <h2>Between blind chat and unreviewed notes.</h2>
      </div>
      <div class="fit-table fit-table-compact" role="table" aria-label="Where Contextarr fits">
        <div class="fit-row fit-row-head" role="row">
          <span role="columnheader">Approach</span>
          <span role="columnheader">Fit</span>
          <span role="columnheader">Result</span>
        </div>
        {contextFitRows.map((row) => (
          <div class="fit-row" role="row">
            <span role="cell">{row.option}</span>
            <span role="cell">{row.fit}</span>
            <span role="cell">{row.outcome}</span>
          </div>
        ))}
      </div>
    </div>
  </section>
  <AudiencePositioning />
  <ProofComparison />

  <section class="section final-cta">
    <div class="container cta-panel">
      <p class="eyebrow">Built in public</p>
      <h2>Built in public.</h2>
      <p>
        Contextarr is being developed as an open-source, local-first project. Inspect the source, run the demo packs,
        and give feedback on the pack format.
      </p>
      <div class="hero-actions">
        <a class="button button-primary" href={links.github}>GitHub</a>
        <a class="button button-secondary" href="/security">Security</a>
        <a class="button button-quiet" href="/roadmap">Roadmap</a>
      </div>
    </div>
  </section>
</BaseLayout>
