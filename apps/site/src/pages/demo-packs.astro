---
import BaseLayout from "../layouts/BaseLayout.astro";
import { demoPackCards, links } from "../content/site";
---

<BaseLayout
  title="Demo packs | Contextarr"
  description="Explore the current public-safe Contextarr demo packs and starter packs."
  currentPath="/demo-packs"
>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Demo packs</p>
      <h1>Concrete examples, not empty framework.</h1>
      <p>
        Contextarr includes 15 public-safe demo Context Packs with 120 records and 8 export profiles per pack. They
        show how records, sources, review state, rendering, exports, and read-only MCP fit together.
      </p>
    </div>
  </section>

  <section class="section section-tight">
    <div class="container demo-pack-grid">
      {demoPackCards.map((pack) => (
        <article class="demo-pack-card">
          <div>
            <p class="demo-pack-category">{pack.category}</p>
            <h2>{pack.name}</h2>
            <p>{pack.text}</p>
          </div>
          <dl class="demo-pack-meta">
            <div>
              <dt>Records</dt>
              <dd>{pack.records}</dd>
            </div>
            <div>
              <dt>Profiles</dt>
              <dd>{pack.profiles}</dd>
            </div>
            <div>
              <dt>Trust</dt>
              <dd>{pack.trust}</dd>
            </div>
          </dl>
          <a class="text-link" href={`${links.demoPacks}/${pack.slug}`}>View pack in repo</a>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
