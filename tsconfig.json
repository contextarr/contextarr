{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@contextarr/schema": ["packages/schema/src/index.ts"],
      "@contextarr/pack-validator": ["packages/pack-validator/src/index.ts"],
      "@contextarr/importers": ["packages/importers/src/index.ts"],
      "@contextarr/export-profiles": ["packages/export-profiles/src/index.ts"],
      "@contextarr/server": ["apps/server/src/index.ts"],
      "@contextarr/renderer": ["packages/renderer/src/index.ts"],
      "@contextarr/renderer/markdown": ["packages/renderer/src/markdown.ts"],
      "@contextarr/renderer/static": ["packages/renderer/src/static.ts"]
    }
  },
  "include": ["apps/**/*.ts", "apps/**/*.tsx", "packages/**/*.ts", "vitest.config.ts"]
}
