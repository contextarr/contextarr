# Contextarr local defaults.
# Do not put secrets or real private data in this file.
# Do not expose local services publicly without explicit auth and threat review.

CONTEXTARR_HOST=127.0.0.1
CONTEXTARR_PORT=3210
CONTEXTARR_DATA_DIR=./data
CONTEXTARR_DATABASE_PATH=./data/contextarr.db
CONTEXTARR_PACKS_DIR=./demo-packs
CONTEXTARR_WEB_DIST_DIR=
CONTEXTARR_API_TOKEN=
CONTEXTARR_LAN_MODE=false
CONTEXTARR_TELEMETRY=false

VITE_CONTEXTARR_API_BASE=
VITE_CONTEXTARR_API_TOKEN=

CONTEXTARR_MCP_RESCAN_ON_START=true
CONTEXTARR_MCP_MAX_RESULTS=8
CONTEXTARR_MCP_MAX_RECORD_CHARS=12000
CONTEXTARR_MCP_MAX_PREVIEW_CHARS=24000
CONTEXTARR_MCP_ALLOW_PRIVATE=false
